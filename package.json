{
  "name": "clanky",
  "version": "0.1.0-beta.9",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && npm --prefix dashboard run build",
    "build:bot": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm --prefix dashboard run typecheck",
    "test": "tsx --test tests/*.test.ts",
    "postinstall": "npm install --prefix dashboard --no-audit --no-fund",
    "deploy:commands": "tsx src/scripts/deploy-commands.ts",
    "deploy:commands:prod": "node dist/scripts/deploy-commands.js",
    "dashboard:dev": "npm --prefix dashboard run dev",
    "dashboard:build": "npm --prefix dashboard run build",
    "dashboard:demo": "npm --prefix dashboard run build:demo",
    "dashboard:release": "npm --prefix dashboard run release",
    "release:beta": "npm version prerelease --preid beta --no-git-tag-version",
    "release:minor": "npm version preminor --preid beta --no-git-tag-version"
  },
  "keywords": [
    "discord",
    "discord.js",
    "bot",
    "typescript",
    "mongodb"
  ],
  "license": "MIT",
  "description": "Clanky — a multipurpose Discord bot for community management, moderation and engagement.",
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@napi-rs/canvas": "^1.0.11",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.7",
    "fastify": "^5.12.7",
    "mongoose": "^9.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "author": ""
}
