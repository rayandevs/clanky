{
  "name": "clanky",
  "version": "0.1.0-beta.6",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "deploy:commands": "tsx src/scripts/deploy-commands.ts",
    "deploy:commands:prod": "node dist/scripts/deploy-commands.js",
    "release:beta": "npm version prerelease --preid beta --no-git-tag-version",
    "release:minor": "npm version preminor --preid beta --no-git-tag-version"
  },
  "keywords": [
    "discord",
    "discord.js",
    "bot",
    "typescript",
    "mongodb"
  ],
  "license": "MIT",
  "description": "Clanky — a multipurpose Discord bot for community management, moderation and engagement.",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.11",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.7",
    "mongoose": "^9.11.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "author": ""
}
