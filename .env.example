# ─── Discord ─────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → Bot
DISCORD_TOKEN=
# Application (client) ID from General Information
DISCORD_CLIENT_ID=
# Optional: register commands to one server instantly while developing.
# Leave empty to register commands globally.
DEV_GUILD_ID=

# ─── Database ────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=clanky
# Watch MongoDB change streams so settings edited elsewhere (e.g. the future
# dashboard) refresh instantly. Requires a replica set / MongoDB Atlas.
MONGODB_WATCH_CHANGES=false

# ─── Bot ─────────────────────────────────────────────────
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
# Comma separated user IDs with owner access
OWNER_IDS=
# Optional links shown in /about
SUPPORT_URL=
# Needs the privileged "Message Content" intent enabled in the developer portal.
# Used for message edit/delete logs. Set to false to run without it.
ENABLE_MESSAGE_CONTENT=true

# ─── Dashboard ───────────────────────────────────────────
# The dashboard runs inside the bot process. Set to false to turn it off.
DASHBOARD_ENABLED=true
DASHBOARD_PORT=3000
DASHBOARD_HOST=0.0.0.0
# Public address of the dashboard. Add `${DASHBOARD_URL}/api/auth/callback`
# as a redirect in the developer portal → OAuth2 → Redirects.
DASHBOARD_URL=http://localhost:3000
# OAuth2 → Client Secret. Without it the homepage works but login is off.
DISCORD_CLIENT_SECRET=
# Long random string (32+ chars) that encrypts login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DASHBOARD_SESSION_SECRET=
# Set to true behind a reverse proxy so secure cookies and IPs work.
DASHBOARD_TRUST_PROXY=false
# Optional Discord webhook for anonymous star ratings and notes on /feedback.
# Keep this value server-side only; the dashboard never receives the URL.
FEEDBACK_WEBHOOK_URL=
